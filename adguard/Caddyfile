# ElCaciqueDeck - name map
# Each name on the left is sent to the server on the right.
# All servers run on this same laptop, so "localhost" is correct here.

http://caciquelibrary.home {
	reverse_proxy localhost:8080
}

http://caciqueflix.home {
	reverse_proxy localhost:8096
}

http://caciquedocs.home {
	reverse_proxy localhost:8000
}

http://caciquedash.home {
	reverse_proxy localhost:8888
}

http://caciqueguard.home {
	reverse_proxy localhost:3000
}

