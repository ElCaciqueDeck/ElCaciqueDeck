# ElCaciqueDeck - name map
# Each name on the left is sent to the server on the right.
# All servers run on this same laptop, so "localhost" is correct here.

http://caciquelibrary.home {
	reverse_proxy localhost:8080
}

http://caciqueflix.home {
	reverse_proxy localhost:8096
}

http://caciquedocs.home {
	reverse_proxy localhost:8000
}

http://caciquedash.home {
	reverse_proxy localhost:8888
}

http://caciqueguard.home {
	reverse_proxy localhost:3000
}

http://caciquephotos.home {
	reverse_proxy localhost:2283
}

http://caciquehome.home {
	reverse_proxy localhost:8123
}

http://caciquearcade.home {
	reverse_proxy localhost:8090
}

# Front page: the Cacique Homepage, at http://cacique.home AND at the plain
# laptop number (http://192.168.x.x, no port), so every device in the house
# can open it without changing any settings.
# If the Homepage isn't running, the simple backup page in ./site is shown instead.
http://cacique.home, :80 {
	reverse_proxy 127.0.0.1:3001
	handle_errors {
		root * /srv
		rewrite * /index.html
		file_server
	}
}
